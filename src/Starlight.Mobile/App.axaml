<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Starlight.Mobile.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- Touch targets: 48dp minimum (Material / HIG guidance). -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C5CFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1B1F2A" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.65" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /></Style>
  </Application.Styles>
</Application>
